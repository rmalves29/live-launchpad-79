{
  "//": "Verificação de tipos SÓ PARA MEDIR (não entra no build: o Vite só lê tsconfig.json). Rodar: npx tsc -p tests/tsconfig.typecheck.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "../src/**/*.ts",
    "../src/**/*.tsx"
  ],
  "exclude": [
    "../src/**/*.test.ts",
    "../src/**/*.test.tsx"
  ],
  "///": "Arquivos *.test.ts de src/ rodam no bun (bun:test) e ficam fora desta checagem."
}
